# Auth (required)
AUTH_USER=admin
AUTH_PASS=changeme

# TOTP (optional). If set, a 6-digit TOTP code is required on login.
# Generate a base32 secret e.g. with: node -e "console.log(require('otpauth').Secret.fromUTF8(require('crypto').randomBytes(20).toString('hex')).base32)"
# Or use any standard base32 secret you scan into Google Authenticator / Aegis.
TOTP_SECRET=

# Session secret (required in production)
SESSION_SECRET=please-change-me

# Server port
PORT=3000

# Optional: preset Postgres connection string. If set, the connect page is auto-filled.
DEFAULT_PG_URL=
